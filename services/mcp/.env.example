HOST=127.0.0.1
PORT=8790
PUBLIC_URL=http://127.0.0.1:8790
DATABASE_URL=postgres://mdbase_mcp:replace-this-password@127.0.0.1:5432/mdbase_mcp
MDBASE_CONNECT_URL=http://127.0.0.1:8787

# Use a stable, randomly generated value of at least 32 characters. Changing
# this value makes existing stored Connect credentials and grant keys unreadable.
MDBASE_MCP_MASTER_KEY=local-development-master-key-change-me

# Enable only behind a trusted reverse proxy such as Render.
MDBASE_MCP_TRUST_PROXY=0
# Call log: days kept (1-365) and collection IDs (comma-separated) whose query text is recorded
MDBASE_MCP_CALL_LOG_RETENTION_DAYS=30
MDBASE_MCP_CALL_LOG_QUERY_TEXT_COLLECTIONS=
# Jev ranks search_records results; empty key = off. Defaults: TypeSafe endpoint, jev-1.14.0.
# Through OpenRouter: an OpenRouter key, endpoint https://openrouter.ai/api/v1/systemone, model typesafe/jev-1.14
MDBASE_MCP_TYPESAFE_API_KEY=
MDBASE_MCP_JEV_ENDPOINT=
MDBASE_MCP_JEV_MODEL=
